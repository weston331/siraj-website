# Security & Performance Headers for Cloudflare Pages / Netlify / Vercel
# https://siraj-alathar.com

/*
  # Security Headers
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), magnetometer=(self), gyroscope=(self), accelerometer=(self), microphone=(), camera=(), payment=(), usb=()
  
  # Content Security Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://fonts.googleapis.com https://www.googletagmanager.com https://www.google-analytics.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; media-src 'self' blob: https://verses.quran.com https://audio.qurancdn.com https://*.aladhan.com; connect-src 'self' https://*.supabase.co https://api.aladhan.com https://api.quran.com https://verses.quran.com https://audio.qurancdn.com https://api.bigdatacloud.net https://nominatim.openstreetmap.org https://fonts.googleapis.com https://fonts.gstatic.com https://www.google-analytics.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests;
  
  # HSTS
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  
  # Cross-Origin Policies
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: cross-origin
  
  # Cache Control (default)
  Cache-Control: public, max-age=3600, must-revalidate

# Static Assets - Long cache
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/images/*
  Cache-Control: public, max-age=31536000, immutable
  
/screenshots/*
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

# Service Worker - No cache
/service-worker.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# Manifest
/manifest.json
  Cache-Control: public, max-age=604800
  Content-Type: application/manifest+json
